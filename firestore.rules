rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validWebsiteLead() {
      return request.resource.data.keys().hasAll([
        'customer', 'phone', 'productId', 'source', 'status', 'page', 'createdAt'
      ])
      && request.resource.data.keys().hasOnly([
        'customer', 'phone', 'productId', 'source', 'status', 'page', 'createdAt'
      ])
      && request.resource.data.customer is string
      && request.resource.data.customer.size() >= 2
      && request.resource.data.customer.size() <= 80
      && request.resource.data.phone is string
      && request.resource.data.phone.size() >= 6
      && request.resource.data.phone.size() <= 24
      && request.resource.data.productId in ['DM30', 'DM60', 'DM90', 'HOLI']
      && request.resource.data.source == 'website'
      && request.resource.data.status == 'new'
      && request.resource.data.page is string
      && request.resource.data.page.size() <= 300
      && request.resource.data.createdAt == request.time;
    }

    // Internal CONDUCTOR application. There is intentionally no public sign-up
    // in the client: employee accounts are created in Firebase Authentication.
    match /products/{productId} {
      allow read, write: if signedIn();
    }

    match /orders/{orderId} {
      allow read, write: if signedIn();
    }

    // Public visitors may only CREATE a tightly validated lead. They cannot read,
    // update or delete leads. Authenticated employees can manage them in the app.
    match /leads/{leadId} {
      allow create: if validWebsiteLead();
      allow read, update, delete: if signedIn();
    }

    // Everything else stays closed by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
