rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the two explicitly approved Firebase Authentication accounts can
    // access warehouse data. There is no public sign-up in the application.
    function isStaff() {
      return request.auth != null
        && request.auth.token.keys().hasAll(['email'])
        && request.auth.token.email in [
          'mihagavr@gmail.com',
          'a.kalashin@gmail.com'
        ];
    }

    function validModelId(modelId) {
      return modelId is string && modelId.matches('^[A-Z0-9]{2,24}$');
    }

    // Warehouse variants are valid only when their model is published in catalog.
    function modelExists(modelId) {
      return validModelId(modelId)
        && exists(/databases/$(database)/documents/catalog/$(modelId));
    }

    function validProductId(productId) {
      return productId is string
        && productId.matches('^[A-Z0-9]{2,24}_[A-Z0-9]+$');
    }

    function validProductState(data) {
      return data.keys().hasAll(['modelId', 'name', 'stock'])
        && modelExists(data.modelId)
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.stock is int
        && data.stock >= 0;
    }

    function validProductAuthor(data) {
      return data.updatedBy == request.auth.uid
        && data.updatedAt == request.time
        && data.updatedByName is string
        && data.updatedByName.size() <= 80;
    }

    match /products/{productId} {
      allow read: if isStaff();

      allow create: if isStaff()
        && validProductId(productId)
        && validProductState(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && validProductAuthor(request.resource.data)
        && request.resource.data.keys().hasOnly([
          'id', 'modelId', 'colorId', 'colorName', 'colorHex', 'name',
          'stock', 'lowStock', 'sort', 'active',
          'legacyUnassigned', 'createdAt', 'createdBy',
          'createdByName', 'updatedAt', 'updatedBy', 'updatedByName'
        ]);

      allow update: if isStaff()
        && validProductState(request.resource.data)
        && validProductAuthor(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'stock', 'active', 'modelOnly',
          'variantMigrationV2', 'stockInitialized', 'inventoryInitialized',
          'lastInventoryAt', 'lastInventoryBy', 'lastInventoryByName',
          'updatedAt', 'updatedBy', 'updatedByName'
        ])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'stockInitialized', 'inventoryInitialized', 'lastInventoryAt',
          'lastInventoryBy', 'lastInventoryByName'
        ])
          || (request.resource.data.lastInventoryAt == request.time
            && request.resource.data.lastInventoryBy == request.auth.uid));

      allow delete: if false;
    }

    match /catalog/{modelId} {
      allow read: if true;
      allow create, update: if isStaff()
        && validModelId(modelId)
        && request.resource.data.keys().hasAll([
          'modelId', 'name', 'price', 'updatedAt', 'updatedBy', 'updatedByName'
        ])
        && request.resource.data.keys().hasOnly([
          'modelId', 'name', 'price', 'updatedAt', 'updatedBy', 'updatedByName'
        ])
        && request.resource.data.modelId == modelId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.price is int
        && request.resource.data.price > 0
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedByName is string
        && request.resource.data.updatedByName.size() <= 80;
      allow delete: if false;
    }

    match /publicProducts/{modelId} {
      allow read, write: if false;
    }

    function validOrderAudit(data) {
      return data.source == 'stock-app'
        && data.status == 'done'
        && data.createdBy == request.auth.uid
        && data.createdByEmail == request.auth.token.email
        && data.createdByName is string
        && data.createdByName.size() > 0
        && data.createdByName.size() <= 80
        && data.createdAt == request.time
        && data.createdAtClient is string
        && data.createdAtClient.size() > 0
        && data.createdAtClient.size() <= 80
        && data.note is string
        && data.note.size() <= 300;
    }

    function validSaleOrder(data) {
      return data.get('operationType', '') == ''
        && data.items is list
        && data.items.size() > 0
        && data.items.size() <= 200
        && data.total is number
        && data.total > 0
        && (!data.keys().hasAny(['baseTotal']) || (data.baseTotal is number && data.baseTotal > 0))
        && (!data.keys().hasAny(['pricing']) || data.pricing is map);
    }

    function validCashOrder(data) {
      return data.operationType in ['cash_deposit', 'cash_sawmill']
        && data.amount is int
        && data.amount > 0
        && data.cashDelta is int
        && data.before is int
        && data.before >= 0
        && data.after is int
        && data.after >= 0
        && data.after == data.before + data.cashDelta
        && data.items is list
        && data.items.size() == 0
        && data.total == data.cashDelta
        && ((data.operationType == 'cash_deposit' && data.cashDelta == data.amount)
          || (data.operationType == 'cash_sawmill' && data.cashDelta == -data.amount));
    }

    match /orders/{orderId} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly([
          'items', 'total', 'baseTotal', 'note', 'pricing',
          'operationType', 'amount', 'cashDelta', 'before', 'after',
          'status', 'source', 'createdAt', 'createdAtClient',
          'createdBy', 'createdByEmail', 'createdByName'
        ])
        && validOrderAudit(request.resource.data)
        && (validSaleOrder(request.resource.data) || validCashOrder(request.resource.data));
      allow update: if isStaff()
        && resource.data.status == 'done'
        && resource.data.get('operationType', '') == ''
        && request.resource.data.status == 'cancelled'
        && request.resource.data.cancelledBy == request.auth.uid
        && request.resource.data.cancelledByEmail == request.auth.token.email
        && request.resource.data.cancelledByName is string
        && request.resource.data.cancelledByName.size() > 0
        && request.resource.data.cancelledByName.size() <= 80
        && request.resource.data.cancelledAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'cancelledAt', 'cancelledBy', 'cancelledByEmail',
          'cancelledByName'
        ]);
      allow delete: if false;
    }

    function validMovement(data) {
      return data.keys().hasAll([
          'type', 'inventoryId', 'productId', 'productName', 'qtyDelta',
          'before', 'after', 'unitCost', 'totalCost', 'reason', 'createdAt',
          'createdAtClient', 'createdBy', 'createdByEmail', 'createdByName'
        ])
        && data.keys().hasOnly([
          'type', 'inventoryId', 'productId', 'productName', 'colorId',
          'colorName', 'qtyDelta', 'before', 'after', 'unitCost',
          'totalCost', 'salePrice', 'orderId', 'reason', 'createdAt',
          'createdAtClient', 'createdBy', 'createdByEmail', 'createdByName'
        ])
        && data.type in ['receipt', 'writeoff', 'adjustment', 'sale', 'sale_return']
        && data.inventoryId is string
        && validProductId(data.inventoryId)
        && modelExists(data.productId)
        && data.productName is string
        && data.productName.size() > 0
        && data.productName.size() <= 120
        && data.qtyDelta is int
        && data.qtyDelta != 0
        && data.before is int
        && data.before >= 0
        && data.after is int
        && data.after >= 0
        && data.after == data.before + data.qtyDelta
        && data.unitCost is number
        && data.unitCost >= 0
        && data.totalCost is number
        && data.totalCost >= 0
        && data.reason is string
        && data.reason.size() <= 300
        && data.createdAtClient is string
        && data.createdBy == request.auth.uid
        && data.createdByEmail == request.auth.token.email
        && data.createdByName is string
        && data.createdByName.size() <= 80
        && data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/products/$(data.inventoryId)).data.stock == data.after;
    }

    match /stockMovements/{movementId} {
      allow read: if isStaff();
      allow create: if isStaff() && validMovement(request.resource.data);
      allow update, delete: if false;
    }

    function validCashAudit(data) {
      return data.balance is int
        && data.balance >= 0
        && data.updatedAt == request.time
        && data.updatedBy == request.auth.uid
        && data.updatedByEmail == request.auth.token.email
        && data.updatedByName is string
        && data.updatedByName.size() > 0
        && data.updatedByName.size() <= 80;
    }

    match /finance/{financeId} {
      allow read: if isStaff() && financeId == 'cash';
      allow create: if isStaff()
        && financeId == 'cash'
        && request.resource.data.keys().hasAll([
          'balance', 'initializedAt', 'updatedAt', 'updatedBy',
          'updatedByEmail', 'updatedByName'
        ])
        && request.resource.data.keys().hasOnly([
          'balance', 'initializedAt', 'updatedAt', 'updatedBy',
          'updatedByEmail', 'updatedByName'
        ])
        && request.resource.data.initializedAt == request.time
        && validCashAudit(request.resource.data);
      allow update: if isStaff()
        && financeId == 'cash'
        && validCashAudit(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'balance', 'updatedAt', 'updatedBy', 'updatedByEmail', 'updatedByName'
        ]);
      allow delete: if false;
    }

    match /cashWithdrawals/{withdrawalId} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.keys().hasAll([
          'amount', 'before', 'after', 'comment', 'createdAt',
          'createdAtClient', 'createdBy', 'createdByEmail', 'createdByName'
        ])
        && request.resource.data.keys().hasOnly([
          'amount', 'before', 'after', 'comment', 'createdAt',
          'createdAtClient', 'createdBy', 'createdByEmail', 'createdByName'
        ])
        && request.resource.data.amount is int
        && request.resource.data.amount > 0
        && request.resource.data.before is int
        && request.resource.data.before >= 0
        && request.resource.data.after is int
        && request.resource.data.after == request.resource.data.before - request.resource.data.amount
        && request.resource.data.after >= 0
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 300
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdAtClient is string
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByEmail == request.auth.token.email
        && request.resource.data.createdByName is string
        && request.resource.data.createdByName.size() > 0
        && request.resource.data.createdByName.size() <= 80
        && getAfter(/databases/$(database)/documents/finance/cash).data.balance == request.resource.data.after;
      allow update, delete: if false;
    }

    function validPushDevice(data) {
      return data.keys().hasAll(['uid', 'email', 'token', 'platform', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'token', 'platform', 'updatedAt'])
        && data.uid == request.auth.uid
        && data.email == request.auth.token.email
        && data.token is string
        && data.token.size() >= 20
        && data.token.size() <= 4096
        && data.platform == 'android'
        && data.updatedAt == request.time;
    }

    match /pushDevices/{deviceId} {
      allow read: if false;
      allow create, update: if isStaff() && validPushDevice(request.resource.data);
      allow delete: if isStaff() && resource.data.uid == request.auth.uid;
    }

    match /requests/{requestId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /leads/{leadId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
